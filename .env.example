# Neon, pooled connection string. Used by the app.
DATABASE_URL=

# Neon, direct (unpooled) connection string. Used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Connection string of a dedicated Neon branch for integration tests.
# Never the production database. Without it, the integration tests are skipped.
# Put it in .env.test.local rather than .env.local.
TEST_DATABASE_URL=

# Password of the app (12 characters minimum) and the key that signs sessions
# (32 characters minimum, e.g. `openssl rand -hex 32`).
# Without APP_PASSWORD the app stays open on localhost, but a production build locks completely.
# Set both on Vercel too, for every environment (Production and Preview).
APP_PASSWORD=
SESSION_SECRET=
